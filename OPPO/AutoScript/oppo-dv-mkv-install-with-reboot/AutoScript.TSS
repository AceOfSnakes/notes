CLI(CLI_exec sync)
CLI(CLI_drv.ir.rx.sq 0xaf000)
CLI(CLI_exec mv /mnt/sda1/AutoScript/AutoScript.TSS /mnt/sda1/AutoScript/AutoScript.TSS.bak)
